   "source": [
    "plt.figure(figsize=(7, 4.5))\n",
    "for label in np.unique(model.Labels):\n",
    "    mask = model.Labels == label\n",
    "    plt.scatter(X[mask, 0], X[mask, 1], s=40, alpha=0.8,\n",
    "                edgecolors='k', linewidth=0.3, label=f'Cluster {label} ({mask.sum()} pts)')\n",
    "plt.title(f\"Extended KNN v2 Result (w={weight}, K={len(model.Clusters)}, ARI={ari:.3f})\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()\n"
   ]
  },

   "source": [
    "# Accepted hop distances over traversal steps\n",
    "# Note: Plots accepted hop distances against the final threshold to show step size distribution.\n",
    "plt.figure(figsize=(10, 3.5))\n",
    "plt.plot(model.Distance, 'o-', color='steelblue', alpha=0.6, markersize=3, label='Accepted Hop Distance')\n",
    "plt.axhline(np.mean(model.Distance), color='green', linestyle='--', label=f'Mean = {np.mean(model.Distance):.3f}')\n",
    "plt.axhline(model.threshold(), color='red', linestyle='--', label=f'Final Threshold (mean + {model.w}*std) = {model.threshold():.3f}')\n",
    "plt.title(\"Global Density Learning: Accepted Hop Distances Over Traversal Steps\")\n",
    "plt.xlabel(\"Traversal Step\")\n",
    "plt.ylabel(\"Distance\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 8,
   "metadata": {
    "execution": {
     "iopub.execute_input": "2026-11-11T13:20:21.095118Z",

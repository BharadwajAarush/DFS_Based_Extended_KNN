   "source": [
    "ari = adjusted_rand_score(y, model.Labels)\n",
    "\n",
    "print(f\"Weight parameter w: {model.w}\")\n",
    "print(f\"Adjusted Rand Index (ARI): {ari:.3f}\")\n",
    "print(f\"Clusters found: {len(model.Clusters)}\")\n",
    "print(f\"Cluster sizes: {[len(c) for c in model.Clusters]}\")\n",
    "print(f\"Accepted hop distances recorded: {len(model.Distance)}\")\n"
   ]
  },

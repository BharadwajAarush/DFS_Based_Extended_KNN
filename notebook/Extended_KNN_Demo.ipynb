   "source": [
    "# Running adaptive threshold over time\n",
    "running_mean = [np.mean(model.Distance[:i+1]) for i in range(len(model.Distance))]\n",
    "running_std  = [np.std(model.Distance[:i+1]) for i in range(len(model.Distance))]\n",
    "running_thr  = [running_mean[i] + model.w * running_std[i] for i in range(len(model.Distance))]\n",
    "\n",
    "plt.figure(figsize=(10, 3.5))\n",
    "plt.plot(model.Distance, color='lightgray', alpha=0.7, label='Hop Distance')\n",
    "plt.plot(running_mean, color='green', label='Running Mean')\n",
    "plt.plot(running_thr, color='red', label='Running Threshold (mean + w*std)')\n",
    "plt.title(\"Adaptive Threshold Self-Calibration During Traversal\")\n",
    "plt.xlabel(\"Traversal Step\")\n",
    "plt.ylabel(\"Distance / Threshold\")\n",
    "plt.legend()\n",
    "plt.grid(True, alpha=0.3)\n",
    "plt.show()"
   ]
  },

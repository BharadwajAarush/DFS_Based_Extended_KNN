   "source": [
    "test_weights = [2.0, 3.5, 5.0]\n",
    "\n",
    "plt.figure(figsize=(13, 3.8))\n",
    "for idx, w_val in enumerate(test_weights):\n",
    "    np.random.seed(42)\n",
    "    m_test = ExtendedKNN(X, w=w_val).fit()\n",
    "    ari_val = adjusted_rand_score(y, m_test.Labels)\n",
    "    \n",
    "    plt.subplot(1, 3, idx + 1)\n",
    "    for lbl in np.unique(m_test.Labels):\n",
    "        mask = m_test.Labels == lbl\n",
    "        plt.scatter(X[mask, 0], X[mask, 1], s=25, alpha=0.8, edgecolors='k', linewidth=0.2)\n",
    "    plt.title(f\"w = {w_val} | K = {len(m_test.Clusters)} | ARI = {ari_val:.3f}\")\n",
    "    plt.grid(True, alpha=0.3)\n",
    "plt.tight_layout()\n",
    "plt.show()\n"
   ]
  },

